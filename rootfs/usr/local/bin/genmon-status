#!/usr/bin/env python3
# Usage: genmon-status <starting|running|error> <message> [seconds until retry]
# Written for the ingress "genmon unavailable" page.
import json
import os
import sys
import time

STATUS_FILE = "/run/genmon/status.json"
GENMON_LOG = "/data/log/genmon.log"

state, message = sys.argv[1], sys.argv[2]
retry_in = int(sys.argv[3]) if len(sys.argv) > 3 else None

try:
    with open(STATUS_FILE) as f:
        previous = json.load(f)
except Exception:
    previous = {}

now = time.time()
new_start = state == "starting" and previous.get("state") != "starting"
status = {
    "state": state,
    "message": message,
    "started": now if new_start else previous.get("started", now),
    "next_retry": now + retry_in if retry_in else None,
    "log": [],
}
if state == "error":
    try:
        with open(GENMON_LOG, errors="replace") as f:
            status["log"] = f.read().splitlines()[-10:]
    except OSError:
        pass

os.makedirs(os.path.dirname(STATUS_FILE), exist_ok=True)
tmp = STATUS_FILE + ".tmp"
with open(tmp, "w") as f:
    json.dump(status, f)
os.replace(tmp, STATUS_FILE)
