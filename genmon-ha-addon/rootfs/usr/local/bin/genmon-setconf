#!/usr/bin/env python3
# Usage: genmon-setconf <conf file> <section> <key> <value>
import sys

sys.path.insert(0, "/genmon")
from genmonlib.myconfig import MyConfig

if len(sys.argv) != 5:
    sys.exit("usage: genmon-setconf <file> <section> <key> <value>")

filename, section, key, value = sys.argv[1:]
config = MyConfig(filename=filename, section=section)
if not config.WriteValue(key, value):
    sys.exit("failed to write %s in %s" % (key, filename))
